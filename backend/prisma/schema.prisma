generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int         @id @default(autoincrement())
  name         String
  email        String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  resumes      Resume[]
  interviews   Interview[]
}

model Resume {
  id         Int      @id @default(autoincrement())
  userId     Int
  fileUrl    String
  parsedJson String?
  uploadedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model Interview {
  id          Int         @id @default(autoincrement())
  userId      Int
  type        String
  role        String
  domain      String
  difficulty  String
  mode        String
  status      String
  startedAt   DateTime    @default(now())
  completedAt DateTime?
  user        User        @relation(fields: [userId], references: [id])
  questions   Question[]
  report      Report?
}

model Question {
  id          Int       @id @default(autoincrement())
  interviewId Int
  text        String
  orderIndex  Int
  interview   Interview @relation(fields: [interviewId], references: [id])
  response    Response?
}

model Response {
  id         Int      @id @default(autoincrement())
  questionId Int      @unique
  answerText String
  score      Int?
  feedback   String?
  question   Question @relation(fields: [questionId], references: [id])
}

model Report {
  id                 Int       @id @default(autoincrement())
  interviewId        Int       @unique
  overallScore       Int?
  technicalScore     Int?
  communicationScore Int?
  strengths          String?
  weaknesses         String?
  roadmapText        String?
  interview          Interview @relation(fields: [interviewId], references: [id])
}